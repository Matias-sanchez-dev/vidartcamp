# ARCHIVO DE CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Copia este archivo como .env y modifica los valores

# Secret Key para JWT (CAMBIAR EN PRODUCCIÓN)
# Generar con: openssl rand -hex 32
SECRET_KEY=cambiar-esta-clave-secreta-en-produccion-usar-openssl-rand-hex-32

# Configuración de la aplicación
APP_NAME=Vidartcamp Control de Acceso
DEBUG=False

# Puerto (para Railway/Render, se usa $PORT automáticamente)
PORT=8000

# Configuración de QR
QR_EXPIRATION_SECONDS=120

# Configuración de JWT
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Base de datos (SQLite por defecto)
DATABASE_URL=sqlite:///./vidartcamp.db

# CORS (si necesitas permitir otros dominios)
ALLOWED_ORIGINS=https://vidartcamp.com,https://www.vidartcamp.com

# Configuración adicional
TZ=America/Argentina/Cordoba
